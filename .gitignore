# Ignore everything without an extension, then selectively allow files and directories.
*
!*.*
!*/

# Don't ignore makefiles and license files.
!makefile
!Makefile
!LICENSE

# Don't ignore the test framework submodule.
!libs/test

# Ignore build artifacts.
*.o
*.a
*.d
*.elf
*.hex
*.bin
*.map

# Ignore .txt files.
*.txt

# Ignore solution files.
*atsln

# Ignore CMake files other than CMakeLists.txt.
*CMakeCache.txt
*CMakeFiles
*cmake_install.Makefile
*cmake_install.cmake

# Ignore Python cache.
*__pycache__/

# Ignore IDE directories.
*vscode/
*vs/

# Ignore debug folder.
*Debug/

